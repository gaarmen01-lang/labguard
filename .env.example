# Copier en .env.local (jamais versionné) et renseigner.

# --- Supabase ---------------------------------------------------------------
# URL du projet et clé PUBLIABLE (exposées au navigateur, protégées par la RLS).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé service_role : SERVEUR UNIQUEMENT, contourne la RLS. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ------------------------------------------------------------
# URL publique (liens magiques). Doit figurer dans Supabase > Auth > URL Configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Emails admin d'amorçage, séparés par des virgules (ajoutés à allowed_emails à la connexion).
LABGUARD_ADMIN_EMAILS=

# --- LLM --------------------------------------------------------------------
# Fournisseur : mistral | anthropic | openai_compatible | fake
LLM_PROVIDER=
# Identifiant du modèle chez le fournisseur choisi (aucune valeur par défaut).
LLM_MODEL=
# Clé API du fournisseur (non requise pour « fake »).
LLM_API_KEY=
# Requis pour openai_compatible uniquement (ex. https://api.exemple.com/v1).
LLM_BASE_URL=
# Délai max d'un appel LLM en millisecondes (optionnel).
LLM_TIMEOUT_MS=
